<h2>Historique des campagnes</h2>

<table>
  <thead>
    <tr>
      <th>Titre</th>
      <th>Description</th>
      <th>Début</th>
      <th>Fin</th>
      <th>Statut</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% campaigns.forEach(campaign => { %>
      <tr>
        <td><%= campaign.title %></td>
        <td><%= campaign.description %></td>
        <td><%= campaign.start_date.toISOString().split('T')[0] %></td>
        <td><%= campaign.end_date.toISOString().split('T')[0] %></td>
        <td><%= campaign.status %></td>
        <td>
          <% if (campaign.status === 'active') { %>
            <form action="/admin/campaign/<%= campaign.id %>/close" method="post" style="display:inline;">
              <button type="submit" class="btn btn-danger">Clôturer</button>
            </form>
          <% } else { %>
            <em>Clôturée</em>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
